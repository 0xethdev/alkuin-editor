{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alkuin",
  "version": "0.7.11",
  "identifier": "app.alkuin.desktop",
  "build": {
    "beforeDevCommand": "vp dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vp build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Alkuin",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 29 },
        "transparent": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "followsWindowActiveState"
        },
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://sync.alkuin.app https://*.supabase.co wss://*.supabase.co http://127.0.0.1:54321 ws://127.0.0.1:54321; script-src 'self'; img-src 'self' data: asset: https://asset.localhost https:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../public/fonts/paper-mono/OFL.txt": "fonts/paper-mono/OFL.txt",
      "fonts/LICENSE-Apache-2.0.txt": "fonts/export/LICENSE-Apache-2.0.txt",
      "fonts/OFL-1.1.txt": "fonts/export/OFL-1.1.txt",
      "fonts/SOURCES.txt": "fonts/export/SOURCES.txt",
      "fonts/NEWSREADER-OFL.txt": "fonts/export/NEWSREADER-OFL.txt"
    },
    "createUpdaterArtifacts": false,
    "macOS": {
      "dmg": {
        "background": "dmg/variant-a@2x.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 220 },
        "applicationFolderPosition": { "x": 480, "y": 220 }
      },
      "infoPlist": "Info.plist",
      "entitlements": "./Entitlements.plist",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2NDBBREQ4N0E4NzA3NjcKUldSbkI0ZDYySzFBSnFLTEZQY0JBYTJCemFlZmY2MHBETjdMYUZ6dWtIVk1PL2p4SDNOMUJQZVgK",
      "endpoints": ["https://updates.alkuin.app/latest.json"]
    }
  }
}
